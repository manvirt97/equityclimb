# Keep the PWA shell, its update check and worker revalidating across deployments.
/
  Cache-Control: no-cache, max-age=0, must-revalidate
/index.html
  Cache-Control: no-cache, max-age=0, must-revalidate
/sw.js
  Cache-Control: no-cache, max-age=0, must-revalidate
/release.json
  Cache-Control: no-store
/ec-pwa-update.js
  Cache-Control: no-cache, max-age=0, must-revalidate
